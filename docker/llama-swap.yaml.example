healthCheckTimeout: 300
logLevel: info
startPort: 9000

apiKeys:
  - "${LLM_API_KEY}"

macros:
  llama-server: >-
    /opt/llama/bin/llama-server
    --host 0.0.0.0 --port ${PORT}
    -fa on --jinja --no-webui --metrics

models:
  # One model block. The key ("example-model") is the id clients send as `model`;
  # it must match LLM_MODEL_ID in .env. Point `-m` at a GGUF you downloaded into
  # the models dir (mounted read-only at /models). Copy this block to add more
  # models — clients pick one by name and llama-swap hot-swaps them.
  "example-model":
    name: "Example model"
    cmd: |
      ${llama-server}
      -m /models/example-model.gguf
      -ngl 99 --n-cpu-moe 20
      -c 65536 --cache-type-k q8_0 --cache-type-v q8_0
      -t 8 --parallel 1 -b 2048 -ub 2048 --cache-reuse 256
      --temp 0.7 --top-p 1.0 --min-p 0.01 --repeat-penalty 1.0
    ttl: 1800   # idle seconds before the model unloads and frees VRAM (0 = stay resident)

  # Template — copy, rename the key, and set `-m` to add another model:
  #
  # "another-model":
  #   name: "Another model"
  #   cmd: |
  #     ${llama-server}
  #     -m /models/another-model.gguf
  #     -ngl 99 --n-cpu-moe 22
  #     -c 65536 --cache-type-k q8_0 --cache-type-v q8_0
  #     -t 8 --parallel 1 -b 2048 -ub 2048 --cache-reuse 256
  #     --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 --repeat-penalty 1.0
  #   ttl: 1800
