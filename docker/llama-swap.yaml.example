healthCheckTimeout: 300
logLevel: info
startPort: 9000

apiKeys:
  - "${LLM_API_KEY}"

macros:
  llama-server: >-
    /opt/llama/bin/llama-server
    --host 0.0.0.0 --port ${PORT}
    -fa on --jinja --no-webui --metrics

models:
  "glm-4.7-flash":
    name: "GLM-4.7-Flash (30B-A3B MoE)"
    cmd: |
      ${llama-server}
      -m /models/GLM-4.7-Flash-UD-Q4_K_XL.gguf
      -ngl 99 --n-cpu-moe 20
      -c 65536 --cache-type-k q8_0 --cache-type-v q8_0
      -t 8 --parallel 1 -b 2048 -ub 2048 --cache-reuse 256
      --temp 0.7 --top-p 1.0 --min-p 0.01 --repeat-penalty 1.0
    ttl: 1800

  "qwen3.6-35b-a3b":
    name: "Qwen3.6-35B-A3B (MoE, reasoning)"
    cmd: |
      ${llama-server}
      -m /models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
      -ngl 99 --n-cpu-moe 22
      -c 65536 --cache-type-k q8_0 --cache-type-v q8_0
      -t 8 --parallel 1 -b 2048 -ub 2048 --cache-reuse 256
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 --repeat-penalty 1.0
    ttl: 1800

  "gpt-oss-20b":
    name: "gpt-oss-20B (MXFP4 MoE, agentic/reasoning)"
    cmd: |
      ${llama-server}
      -m /models/gpt-oss-20b-mxfp4.gguf
      -ngl 99 --n-cpu-moe 4
      -c 131072 --cache-type-k q8_0 --cache-type-v q8_0
      -t 8 --parallel 1 -b 2048 -ub 2048 --cache-reuse 256
      --temp 1.0 --top-p 1.0
    ttl: 1800

  "qwen3.5-9b":
    name: "Qwen3.5-9B (dense, hybrid-attn, multimodal, reasoning)"
    cmd: |
      ${llama-server}
      -m /models/Qwen3.5-9B-UD-Q6_K_XL.gguf
      -ngl 99
      -c 204800 -n 32768 --no-context-shift
      --cache-type-k q8_0 --cache-type-v q8_0
      -t 8 --parallel 1 -b 2048 -ub 2048
      --reasoning-format deepseek
      --chat-template-kwargs '{"enable_thinking":true}'
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0
    ttl: 1800

  "ornith-1.0-9b":
    name: "Ornith-1.0-9B (dense, hybrid-attn, agentic coding, reasoning)"
    cmd: |
      ${llama-server}
      -m /models/Ornith-1.0-9B-Q6_K.gguf
      -ngl 99
      -c 204800 -n 32768 --no-context-shift
      --cache-type-k q8_0 --cache-type-v q8_0
      -t 8 --parallel 1 -b 2048 -ub 2048
      --reasoning-format deepseek
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0
    ttl: 1800
