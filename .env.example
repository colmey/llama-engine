# Copy to .env. Used by docker compose (env_file) AND scripts/chat.py.
# Do NOT commit the real .env — it is git-ignored.
#   echo "LLM_API_KEY=$(cat .api-key)" > .env

# API key clients send as a bearer token. Must match .api-key.
#   openssl rand -hex 32 > .api-key && chmod 600 .api-key
LLM_API_KEY=

# Where the server listens (OpenAI-compatible base URL).
LLM_BASE_URL=http://127.0.0.1:8081/v1

# Default model id requested by the clients (must match a key in llama-swap.yaml).
LLM_MODEL_ID=example-model

# Host dir holding the GGUFs, mounted to /models. Defaults to ./models if unset.
# Point at a larger/faster disk to keep big models off the root partition.
MODELS_DIR=./models

# Host port exposed on the network (docker-compose.yml). Defaults to 8081 if unset.
LLM_HOST_PORT=8081
